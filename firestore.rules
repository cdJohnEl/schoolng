rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function inSchool(schoolId) { return isAuth() && userDoc().schoolId == schoolId; }
    function isAdmin() { return isAuth() && userDoc().role in ['proprietor','admin','bursar']; }

    match /users/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
    }
    match /schools/{schoolId} {
      allow read:   if inSchool(schoolId);
      allow create: if isAuth();
      allow update: if inSchool(schoolId) && isAdmin();
    }
    match /sessions/{id} {
      allow read:  if inSchool(resource.data.schoolId);
      allow write: if isAdmin() && inSchool(request.resource.data.schoolId);
    }
    match /students/{id} {
      allow read:   if inSchool(resource.data.schoolId);
      allow create: if isAdmin() && inSchool(request.resource.data.schoolId);
      allow update: if isAdmin() && inSchool(resource.data.schoolId);
      allow delete: if isAdmin() && inSchool(resource.data.schoolId);
    }
    match /classes/{id} {
      allow read:  if inSchool(resource.data.schoolId);
      allow write: if isAdmin() && inSchool(request.resource.data.schoolId);
    }
    match /subjects/{id} {
      allow read:  if inSchool(resource.data.schoolId);
      allow write: if isAdmin() && inSchool(request.resource.data.schoolId);
    }
    match /staff/{id} {
      allow read:  if inSchool(resource.data.schoolId);
      allow write: if isAdmin() && inSchool(request.resource.data.schoolId);
    }
    match /feeStructures/{id} {
      allow read:  if inSchool(resource.data.schoolId);
      allow write: if isAdmin() && inSchool(request.resource.data.schoolId);
    }
    match /feePayments/{id} {
      allow read:  if inSchool(resource.data.schoolId);
      allow write: if isAdmin() && inSchool(request.resource.data.schoolId);
    }
    match /attendance/{id} {
      allow read:  if inSchool(resource.data.schoolId);
      allow write: if isAuth() && inSchool(request.resource.data.schoolId);
    }
    match /subjectResults/{id} {
      allow read:  if inSchool(resource.data.schoolId);
      allow write: if isAuth() && inSchool(request.resource.data.schoolId);
    }
    match /messages/{id} {
      allow read:   if inSchool(resource.data.schoolId);
      allow create: if isAdmin() && inSchool(request.resource.data.schoolId);
    }
  }
}
